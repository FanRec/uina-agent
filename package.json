{
  "name": "uina",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Uina — 最小 agent 切片",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "uina": "./dist/src/main.js"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "start:dist": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "typecheck": "pnpm check:boundaries && tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify:cli": "tsx scripts/verify-built-cli.mts",
    "verify:file-events": "tsx scripts/verify-file-events.mts",
    "dev:baseline": "node dev/baseline.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "tsx": "^4.23.13"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "cli-highlight": "^2.1.11",
    "jiti": "^2.7.0"
  }
}
