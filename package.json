{
  "name": "uina",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Uina — 最小 agent 切片",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "uina": "./dist/src/main.js"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "start:dist": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "dev:mc": "tsx .uina/worlds/minecraft/dev/entry.ts",
    "dev:mc:k1": "tsx .uina/worlds/minecraft/dev/k1.ts",
    "dev:mc:k2": "tsx .uina/worlds/minecraft/dev/k2.ts",
    "dev:mc:containers": "tsx .uina/worlds/minecraft/dev/k2-containers.ts",
    "dev:mc:k3": "tsx .uina/worlds/minecraft/dev/k3.ts",
    "dev:mc:repair": "tsx .uina/worlds/minecraft/dev/repair.ts",
    "dev:mc:production-repair": "tsx .uina/worlds/minecraft/dev/production-repair.ts",
    "dev:mc:executor": "tsx .uina/worlds/minecraft/dev/executor.ts",
    "dev:mc:native": "tsx .uina/worlds/minecraft/dev/native-host.ts",
    "dev:mc:model": "tsx .uina/worlds/minecraft/dev/native-host.ts --model",
    "dev:mc:program": "tsx .uina/worlds/minecraft/dev/program.ts",
    "dev:mc:places": "tsx .uina/worlds/minecraft/dev/places.ts",
    "dev:mc:mobility": "tsx .uina/worlds/minecraft/dev/mobility.ts",
    "dev:mc:combat": "tsx .uina/worlds/minecraft/dev/combat.ts",
    "dev:mc:spatial": "tsx .uina/worlds/minecraft/dev/spatial.ts",
    "dev:mc:i2": "tsx .uina/worlds/minecraft/dev/i2.ts",
    "dev:mc:history": "tsx .uina/worlds/minecraft/dev/history.ts",
    "dev:mc:wait": "tsx .uina/worlds/minecraft/dev/wait.ts",
    "dev:mc:feedback": "tsx .uina/worlds/minecraft/dev/feedback.ts",
    "dev:mc:library": "tsx .uina/worlds/minecraft/dev/library.ts",
    "dev:mc:build": "tsx .uina/worlds/minecraft/dev/build.ts",
    "dev:mc:stations": "tsx .uina/worlds/minecraft/dev/stations.ts",
    "dev:mc:k8": "tsx .uina/worlds/minecraft/dev/k8.ts",
    "dev:mc:players": "tsx .uina/worlds/minecraft/dev/players.ts",
    "dev:mc:map": "tsx .uina/worlds/minecraft/dev/map.ts",
    "dev:mc:review": "tsx .uina/worlds/minecraft/dev/review-live.ts",
    "dev:mc:session": "tsx .uina/worlds/minecraft/dev/session-live.ts",
    "dev:mc:climb": "tsx .uina/worlds/minecraft/dev/climb.ts",
    "dev:mc:transit": "tsx .uina/worlds/minecraft/dev/transit.ts",
    "dev:mc:digest": "tsx .uina/worlds/minecraft/dev/digest.ts",
    "dev:mc:terrain-nav": "tsx .uina/worlds/minecraft/dev/terrain-nav.ts",
    "dev:mc:upstream-nav": "tsx .uina/worlds/minecraft/dev/upstream-nav.ts",
    "build": "node scripts/clean-dist.mjs && node scripts/build-mc-native.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && pnpm build:web",
    "build:web": "tsc -p tsconfig.web.json && node scripts/copy-web-static.mjs",
    "test": "vitest run",
    "typecheck": "biome format . && pnpm check:boundaries && tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "dev:baseline": "node dev/baseline.mjs",
    "mo:preview": "tsx scripts/mo-preview.mts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify:cli": "tsx scripts/verify-built-cli.mts",
    "verify:gateway": "tsx scripts/verify-gateway.mts",
    "verify:file-events": "tsx scripts/verify-file-events.mts",
    "bench:ui": "tsx scripts/ui-frame-bench.ts",
    "diagnose:frames": "tsx scripts/diagnose-frame-log.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "ajv": "^8.20.0",
    "cli-highlight": "^2.1.11",
    "jiti": "^2.7.0",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "quickjs-emscripten": "0.32.0",
    "ws": "^8.21.3"
  }
}
