{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "exclude": ["src/web-client", "dist"],
  "include": ["examples", "src", "tests", "scripts", "vitest.config.ts", ".uina/apps", ".uina/extensions", ".uina/worlds/live2d", ".uina/worlds/minecraft", ".uina/worlds/soundboard"]
}
