-      } else if (offsetZ < 0.0 && other.minZ >= this.maxZ) {
-        offsetZ = Math.max(this.maxZ - other.minZ, offsetZ)
+      if (offsetZ > 0.0 && other.maxZ <= this.minZ + WALL_GAP) {
+        offsetZ = Math.min(this.minZ - other.maxZ - WALL_GAP, offsetZ)
