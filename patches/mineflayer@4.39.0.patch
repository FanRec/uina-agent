+// 1.21.9+ sends entity velocity as lpVec3, which already decodes to blocks per
+// tick; the old short encoding was 1/8000 of a block per tick. Applying
+// fromNotchVelocity to the new format shrinks every knockback by 8000x
+// (upstream issue #4167). Keep the old branch for older protocol versions.
+function velocityFromPacket (bot, velocity) {
+  const raw = new Vec3(velocity.x, velocity.y, velocity.z)
+  return bot.registry.version['>=']('1.21.9') ? raw : conv.fromNotchVelocity(raw)
+}
