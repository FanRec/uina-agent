{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"src/**",
			"tests/**",
			"scripts/**",
			"examples/**",
			"vitest.config.ts",
			".uina/worlds/live2d/**/*.ts",
			".uina/worlds/live2d/**/*.mjs"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"overrides": [
		{
			"includes": ["**/models/mo/**"],
			"formatter": {
				"lineWidth": 320
			}
		}
	],
	"linter": {
		"enabled": false
	}
}
